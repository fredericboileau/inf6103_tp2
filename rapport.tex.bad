\subsection*{Périmètre et conditions}
\begin{itemize}
  \item Point d'entrée : carte RasPi (\texttt{ssh root@\ipvm{} -p 2222}).
  \item Caméra de surveillance de la cuve : \url{http://ip_vm:80}.
  \item Interface de contrôle (tunnel) : \url{http://ip_vm:9090/}.
  \item Interface de programmation du PLC (tunnel) : \url{http://ip_vm:8080/}.
\end{itemize}

