\subsection{Cartographie des machines et services}
\question{1.1}{Identifiez les machines présentes sur le réseau et les services
qu'elles offrent (tableau : adresse IP, nom d'hôte, ports ouverts, services).}

\begin{lstlisting}[style=shell, caption={Découverte des hôtes et des services}, label={lst:nmap}]
# Commandes utilisées
nmap -sn 10.0.0.0/24
nmap -sV -p- <ip>
\end{lstlisting}

\begin{table}[H]
  \centering
  \caption{Machines et services détectés sur le réseau de l'usine}
  \label{tab:hosts}
  \begin{tabularx}{\linewidth}{@{}l l l X@{}}
    \toprule
    \textbf{Adresse IP} & \textbf{Nom d'hôte} & \textbf{Ports ouverts} & \textbf{Services détectés} \\
    \midrule
    \todo{x.x.x.x} & \todo{hôte} & 22/tcp & SSH (OpenSSH x.y) \\
                   &             & 80/tcp & HTTP \\
    \todo{x.x.x.x} & \todo{hôte} & 502/tcp & Modbus/TCP \\
    \bottomrule
  \end{tabularx}
\end{table}

